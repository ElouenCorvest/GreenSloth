      \field{number}{1730}
      \field{shorttitle}{Hacking the Thylakoid Proton Motive Force for Improved Photosynthesis}
      \field{title}{Hacking the Thylakoid Proton Motive Force for Improved Photosynthesis: Modulating Ion Flux Rates That Control Proton Motive Force Partitioning into {{$\Delta$}} {\emph{{$\psi$}}} and {{$\Delta$pH}}}
